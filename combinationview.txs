import React, { useState } from 'react';
import { PaletteColor } from '../types';
import { getContrastRatio, copyTextToClipboard } from '../utils/colorUtils';
import { Copy, Check, Sparkles, Sliders, ShieldCheck, ShieldAlert } from 'lucide-react';

interface CombinationsViewProps {
  palette: PaletteColor[];
  onToast: (msg: string) => void;
}

export const CombinationsView: React.FC<CombinationsViewProps> = ({ palette, onToast }) => {
  const [copiedText, setCopiedText] = useState<string | null>(null);
  const [gradientAngle, setGradientAngle] = useState<number>(135);

  const handleCopy = async (text: string, label: string) => {
    const success = await copyTextToClipboard(text);
    if (success) {
      setCopiedText(text);
      onToast(`Copied ${label} to clipboard!`);
      setTimeout(() => setCopiedText(null), 2000);
    }
  };

  const gradientCss = `linear-gradient(${gradientAngle}deg, ${palette.map((c) => c.hex).join(', ')})`;

  return (
    <div className="w-full flex flex-col gap-8">
      {/* Header */}
      <div className="bg-neutral-900/50 p-4 rounded-xl border border-neutral-800 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <h2 className="text-sm font-semibold text-white tracking-wide flex items-center gap-2">
            <Sparkles className="w-4 h-4 text-indigo-400" />
            <span>Harmonic Combinations & Accessibility Matrix</span>
          </h2>
          <p className="text-xs text-neutral-400 mt-0.5">
            Evaluate contrast ratios according to WCAG 2.1 guidelines and craft ultra-smooth multi-stop gradients.
          </p>
        </div>
      </div>

      {/* SECTION 1: CSS GRADIENT STUDIO */}
      <div className="bg-neutral-900/60 rounded-2xl p-4 sm:p-6 border border-neutral-800 flex flex-col gap-4">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h3 className="text-sm font-bold text-white tracking-wide">Multi-Stop Pantone Gradient</h3>
            <p className="text-xs text-neutral-400">Blended seamlessly across your active color sequence</p>
          </div>

          {/* Angle slider & Copy CSS */}
          <div className="flex items-center gap-3 sm:gap-4 flex-wrap">
            <div className="flex items-center gap-2 text-xs text-neutral-400">
              <Sliders className="w-3.5 h-3.5" />
              <span>{gradientAngle}°</span>
              <input
                type="range"
                min="0"
                max="360"
                value={gradientAngle}
                onChange={(e) => setGradientAngle(Number(e.target.value))}
                className="w-20 sm:w-24 accent-white cursor-pointer"
              />
            </div>

            <button
              onClick={() => handleCopy(`background: ${gradientCss};`, 'Gradient CSS')}
              className="px-3 py-1.5 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-neutral-200 text-xs font-mono font-semibold flex items-center gap-1.5 transition border border-neutral-700"
            >
              {copiedText?.includes('linear-gradient') ? (
                <Check className="w-3.5 h-3.5 text-emerald-400" />
              ) : (
                <Copy className="w-3.5 h-3.5" />
              )}
              <span>Copy CSS</span>
            </button>
          </div>
        </div>

        {/* Gradient Visual Strip */}
        <div
          className="w-full min-h-[140px] sm:h-36 rounded-xl shadow-lg border border-neutral-700/50 flex flex-col sm:flex-row items-start sm:items-end justify-between p-3.5 sm:p-4 gap-2 relative overflow-hidden"
          style={{ background: gradientCss }}
        >
          <div className="px-2.5 py-1 rounded-lg bg-black/60 backdrop-blur-md text-white text-[11px] sm:text-xs font-mono max-w-full truncate">
            {gradientCss}
          </div>
          <button
            onClick={() => handleCopy(palette.map((c) => c.hex).join(', '), 'Hex sequence')}
            className="px-3 py-1.5 rounded-lg bg-white text-neutral-950 text-xs font-bold shadow-md hover:bg-neutral-100 transition shrink-0"
          >
            Copy Color Sequence
          </button>
        </div>
      </div>

      {/* SECTION 2: PAIRWISE CONTRAST & ACCESSIBILITY MATRIX */}
      <div className="bg-neutral-900/60 rounded-2xl p-4 sm:p-6 border border-neutral-800 flex flex-col gap-4">
        <div>
          <h3 className="text-sm font-bold text-white tracking-wide">Pairwise Contrast & Readability Matrix</h3>
          <p className="text-xs text-neutral-400">
            Preview text legibility between color pairings. WCAG standards require ≥ 4.5:1 for body text (AA) and ≥ 7.0:1 (AAA).
          </p>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-2">
          {palette.flatMap((bgCol, i) =>
            palette
              .filter((_, j) => i !== j)
              .map((fgCol, j) => {
                const ratio = getContrastRatio(fgCol.rgb, bgCol.rgb);
                const passAA = ratio >= 4.5;
                const passAAA = ratio >= 7.0;

                return (
                  <div
                    key={`${i}-${j}`}
                    className="rounded-xl p-4 flex flex-col justify-between border border-neutral-700/40 shadow-sm transition hover:shadow-md"
                    style={{ backgroundColor: bgCol.hex }}
                  >
                    <div>
                      {/* Badge bar */}
                      <div className="flex items-center justify-between mb-3">
                        <span
                          className="text-[10px] font-mono px-2 py-0.5 rounded backdrop-blur-md border border-black/10"
                          style={{
                            backgroundColor: 'rgba(0,0,0,0.2)',
                            color: '#ffffff',
                          }}
                        >
                          Ratio: {ratio} : 1
                        </span>

                        <div className="flex items-center gap-1">
                          {passAAA ? (
                            <span className="inline-flex items-center gap-0.5 text-[9px] font-bold px-1.5 py-0.5 rounded bg-emerald-500 text-white shadow-xs">
                              <ShieldCheck className="w-3 h-3" /> AAA
                            </span>
                          ) : passAA ? (
                            <span className="inline-flex items-center gap-0.5 text-[9px] font-bold px-1.5 py-0.5 rounded bg-amber-500 text-black shadow-xs">
                              <ShieldCheck className="w-3 h-3" /> AA
                            </span>
                          ) : (
                            <span className="inline-flex items-center gap-0.5 text-[9px] font-medium px-1.5 py-0.5 rounded bg-rose-900/80 text-rose-200">
                              <ShieldAlert className="w-3 h-3" /> Low
                            </span>
                          )}
                        </div>
                      </div>

                      {/* Foreground Text Preview */}
                      <div style={{ color: fgCol.hex }}>
                        <h4 className="font-serif text-lg font-bold leading-snug">
                          {fgCol.name} on {bgCol.name}
                        </h4>
                        <p className="text-xs mt-1 leading-relaxed opacity-90 font-sans">
                          Sample body typography for architectural editorial or web UI applications.
                        </p>
                      </div>
                    </div>

                    {/* Bottom Quick-Copy Bar */}
                    <div className="mt-4 pt-3 border-t border-black/10 flex items-center justify-between text-[11px] font-mono">
                      <button
                        onClick={() => handleCopy(fgCol.hex, fgCol.name)}
                        className="px-2 py-0.5 rounded bg-black/30 hover:bg-black/50 text-white transition flex items-center gap-1"
                        title="Copy text color hex"
                      >
                        <Copy className="w-2.5 h-2.5" /> Text: {fgCol.hex}
                      </button>

                      <button
                        onClick={() => handleCopy(bgCol.hex, bgCol.name)}
                        className="px-2 py-0.5 rounded bg-black/30 hover:bg-black/50 text-white transition flex items-center gap-1"
                        title="Copy background color hex"
                      >
                        <Copy className="w-2.5 h-2.5" /> BG: {bgCol.hex}
                      </button>
                    </div>
                  </div>
                );
              })
          )}
        </div>
      </div>
    </div>
  );
};
